# Ghostty configuration. Run `ghostty +show-config --default --docs` or see
# https://ghostty.org/docs/config for every option.

# ----- appearance -----
# font-family = "RecMonoDuotone Nerd Font"
font-family = "RecMonoLinear Nerd Font"
font-family-bold = "RecMonoLinear Nerd Font"
font-size = 16
font-thicken = true
# Only the last `theme` line takes effect; alternatives:
# theme = Blue Berry Pie
# theme = Blazer
# theme = Catppuccin Mocha
# theme = Cursor Dark
theme = Vesper
adjust-cell-height = 2

# ----- font codepoint maps (TC)-----
font-codepoint-map = U+4E00-U+9FFF,U+3000-U+303F,U+FF00-U+FFEF,U+FE30-U+FE4F=Heiti TC

# ----- macOS-specific settings -----
macos-titlebar-style = native
macos-option-as-alt = true
macos-icon = official

# ----- Cursor & behavior -----
cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.3
copy-on-select = clipboard
link-url = true
shell-integration-features = "no-cursor"
selection-background = #505050

# ----- key bindings -----
# Splits, tabs and clearing use the native Cmd shortcuts (`ghostty +list-keybinds`),
# leaving Ctrl-h/j/k/l to the shell, tmux and Neovim.
keybind = ctrl+left_bracket=text:\x1b

window-save-state = always
